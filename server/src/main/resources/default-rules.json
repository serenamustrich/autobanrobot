{
  "version": 12,
  "engine": {
    "schemaVersion": 1
  },
  "keywordSets": [],
  "keywordPolicies": [
    {
      "id": "english-complete-token",
      "scopes": ["content", "username", "displayName"],
      "operator": "token",
      "normalization": "raw",
      "minLength": 1,
      "keywordPattern": "^[A-Za-z][A-Za-z0-9_ -]*$",
      "keywordFlags": "u",
      "flags": "iu"
    },
    {
      "id": "non-english-literal",
      "scopes": ["content", "username", "displayName"],
      "operator": "includes",
      "normalization": "compact",
      "minLength": 1,
      "keywordPattern": "^(?![A-Za-z][A-Za-z0-9_ -]*$).+$",
      "keywordFlags": "u"
    },
    {
      "id": "non-english-symbol-noise",
      "scopes": ["content", "username", "displayName"],
      "operator": "includes",
      "normalization": "noSymbols",
      "minLength": 2,
      "keywordPattern": "^(?![A-Za-z][A-Za-z0-9_ -]*$).+$",
      "keywordFlags": "u"
    },
    {
      "id": "han-interference-noise",
      "scopes": ["content", "username", "displayName"],
      "operator": "includes",
      "normalization": "hanNoise",
      "minLength": 2,
      "keywordPattern": "^\\p{Script=Han}{2,}$",
      "keywordFlags": "u"
    }
  ],
  "accountPolicies": [
    {
      "id": "complete-account-target",
      "keywordPattern": "^@([A-Za-z0-9_]{1,15})$",
      "keywordFlags": "u",
      "targets": [
        {
          "scope": "content",
          "pattern": "(^|[^\\p{L}\\p{N}_])@{{1}}(?=$|[^\\p{L}\\p{N}_])",
          "flags": "iu",
          "normalization": "raw"
        },
        {
          "scope": "username",
          "pattern": "^{{1}}$",
          "flags": "iu",
          "normalization": "raw"
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "single-emoji-content",
      "name": "仅单个 Emoji",
      "description": "只匹配整条内容仅有一个完整 Emoji",
      "enabled": false,
      "scope": "content",
      "condition": {
        "type": "singleEmoji"
      }
    },
    {
      "id": "emoji-content-emoji",
      "name": "Emoji + 内容 + Emoji",
      "description": "以 Emoji 开头和结尾，中间必须包含文字或数字；纯 Emoji 不命中",
      "enabled": true,
      "scope": "content",
      "normalization": "raw",
      "pattern": "^\\s*\\p{Extended_Pictographic}(?=[\\s\\S]*[\\p{L}\\p{N}])[\\s\\S]*\\p{Extended_Pictographic}\\s*$",
      "flags": "u"
    },
    {
      "id": "five-segment-alternating",
      "name": "五段式交替",
      "description": "非 Emoji → Emoji → 非 Emoji → Emoji → 非 Emoji",
      "enabled": true,
      "scope": "content",
      "condition": {
        "all": [
          { "type": "lineCount", "equals": 5 },
          { "type": "lineAt", "index": 0, "condition": { "not": { "type": "singleEmoji" } } },
          { "type": "lineAt", "index": 1, "condition": { "type": "singleEmoji" } },
          { "type": "lineAt", "index": 2, "condition": { "not": { "type": "singleEmoji" } } },
          { "type": "lineAt", "index": 3, "condition": { "type": "singleEmoji" } },
          { "type": "lineAt", "index": 4, "condition": { "not": { "type": "singleEmoji" } } }
        ]
      }
    },
    {
      "id": "three-segment-single-middle",
      "name": "三段式中间单字符",
      "description": "任意内容 → 单个字符 → 任意内容",
      "enabled": true,
      "scope": "content",
      "condition": {
        "all": [
          { "type": "lineCount", "equals": 3 },
          { "type": "lineAt", "index": 1, "condition": { "type": "graphemeCount", "equals": 1 } }
        ]
      }
    },
    {
      "id": "four-segment-code-emoji",
      "name": "编码分段 + 单 Emoji",
      "description": "3–6 行短编码内容中恰有一行单 Emoji，Emoji 可出现在任意行",
      "enabled": true,
      "scope": "content",
      "condition": {
        "all": [
          { "type": "lineCount", "min": 3, "max": 6 },
          { "type": "countLines", "condition": { "type": "singleEmoji" }, "equals": 1 },
          { "type": "countLines", "condition": { "not": { "type": "singleEmoji" } }, "min": 2 },
          {
            "type": "allLines",
            "where": { "not": { "type": "singleEmoji" } },
            "condition": { "type": "regex", "pattern": "^[A-Za-z0-9._-]{1,16}$", "flags": "u" }
          },
          { "type": "anyLine", "condition": { "type": "regex", "pattern": "\\d", "flags": "u" } }
        ]
      }
    },
    {
      "id": "emoji-copy-tcn-link",
      "name": "文案 + 多 Emoji + t.cn 短链",
      "description": "不限关键词和语言，t.cn 短链需单独成行",
      "enabled": true,
      "normalization": "raw",
      "pattern": "(?=[\\s\\S]*[\\p{L}\\p{N}])(?=(?:[\\s\\S]*\\p{Extended_Pictographic}){2,})(?=[\\s\\S]*(?:^|\\n)\\s*(?:https?:\\/\\/)?t\\.cn\\/[a-z0-9]{5,}(?:[?#]\\S*)?\\s*(?:\\n|$))",
      "flags": "imu"
    },
    {
      "id": "two-line-single-latin-letter",
      "name": "双行单字母",
      "description": "恰好两行，每行仅一个拉丁字母",
      "enabled": true,
      "scope": "content",
      "normalization": "raw",
      "pattern": "^[\\t ]*[a-z][\\t ]*\\r?\\n[\\t ]*[a-z][\\t ]*$",
      "flags": "iu"
    },
    {
      "id": "praise-solicitation-copy",
      "name": "夸赞引流组合文案",
      "description": "多分句夸赞文案同时出现陪玩、在线、推荐或尝试等引流特征",
      "enabled": true,
      "scope": "content",
      "normalization": "raw",
      "pattern": "^(?=[\\s\\S]{15,100}$)(?=(?:[^，\\n]*，){2})(?=[\\s\\S]*(?:阳光|小姐姐|画面|表情|动作|笑容|气质|好看|自然感|治愈|清爽|氛围|质感))(?=[\\s\\S]*(?:陪玩|(?:你|小姐姐)[\\s\\S]{0,45}(?:真心推荐|推荐你|尝试这个|试试这个|在线|适合做这个)|(?:真心推荐|推荐你)[\\s\\S]{0,45}(?:你|小姐姐)))[\\s\\S]*$",
      "flags": "u"
    },
    {
      "id": "generated-name-number-id",
      "name": "名字数字型机器账号 ID",
      "description": "英文名字 + 两位数字 + 两个字母 + 一位数字，并使用默认头像",
      "enabled": true,
      "scope": "username",
      "requiresDefaultAvatar": true,
      "normalization": "raw",
      "pattern": "^[a-z]{4,12}[0-9]{2}[a-z]{2}[0-9]$",
      "flags": "iu"
    },
    {
      "id": "generated-camelcase-id",
      "name": "CamelCase 随机尾机器账号 ID",
      "description": "12–15 位、恰好两个大写字母的英文姓名形 ID，并使用默认头像",
      "enabled": true,
      "scope": "username",
      "requiresDefaultAvatar": true,
      "normalization": "raw",
      "pattern": "^(?=.{12,15}$)(?=(?:[^A-Z]*[A-Z]){2}[^A-Z]*$)[A-Z][a-z]{2,11}[A-Za-z0-9]{4,12}$",
      "flags": "u"
    }
  ]
}
